---
import Base from '../layouts/Base.astro';
import Features from '../components/Features.astro';
// Ported verbatim from the single-page docs/index.html (2026-10-03).
// Visual redesign is a separate pass; this file is the baseline.
---
<Base title="arkiv · 用 AI 建立你的本地影音素材庫" description="以本地 AI 模型建立的影音素材庫，為小型影視團隊與個人創作者而做。收工後的過片、挑選毛片、分類場景、轉錄字幕批量處理：有畫面的分析畫面，有聲音的轉錄成逐字稿。不依賴雲端服務，免費且商用不受限。" current="home">
<meta slot="head" property="og:title" content="arkiv · 用 AI 建立你的本地影音素材庫">
<meta slot="head" property="og:description" content="本地 AI 影音素材庫。過片、挑毛片、分類場景、轉錄字幕批量處理。免費、商用不受限、原始碼公開。">
<meta slot="head" property="og:type" content="website">
<link slot="head" rel="alternate" hreflang="en" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/en.html`}>

<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Media Asset Manager · 本機優先</div>
    <div class="wordmark">arkiv<span class="dot">.</span></div>
    <!-- 🔴 底下的中文段落刻意寫成單行，不要為了好讀而折行。HTML 把原始碼的換行
         算成一個空白：在英文無所謂，在中文會於句號、頓號後面多出一個半形空隙。
         2026-09-03 量到 17 處，全部來自折行。要斷行只能斷在中英交界（那裡本來
         就該有空格），或改用 <br>。 -->
    <p class="lede">用 AI 建立你的本地影音素材庫。</p>
    <!-- 一句一行（Hevin 2026-10-05）。用 <br> 斷，不用多個 <p>：三句是同一段，行距不該拉開。 -->
    <p class="sub">arkiv 是一個以本地 AI 模型為架構、提供小型影視團隊、個人創作者的影音素材庫。<br>主要任務是解決<wbr>影像工作者<wbr>在拍攝工作結束之後<wbr>需要人工大量過片、挑選毛片、分類場景、轉錄字幕等大量重複性的工作。<br>核心的架構以影視工業的 <b>DIT 工作流程</b>靠攏，也就是收檔、編號、校驗、建索引。</p>
    <p class="sub"><b style="color:var(--ink)">大型劇組團隊設有 DIT 崗位專門做這些任務，但在小型團隊裡，收工後的過檔才是噩夢的開始。</b><br>arkiv 在技術上利用本地的 AI 模型以及固化的流程，可以批量地索引素材，不依賴雲端服務，安全、無衍生費用。</p>

    <div class="badges">
      <span class="badge"><b>免費</b>　任何用途</span>
      <span class="badge"><b>商用不受限</b>　含客戶委製</span>
      <span class="badge"><b>原始碼公開</b>　source-available</span>
      <span class="badge">DaVinci Resolve 原生</span>
      <span class="badge">中／日／英 語意搜尋</span>
    </div>

    <div class="dl">
      <a class="btn" href="https://github.com/vulture-s/arkiv/releases/latest">
        下載 macOS 版<small>Apple Silicon · .dmg</small>
      </a>
      <a class="btn" href="https://github.com/vulture-s/arkiv/releases/latest">
        下載 Windows 版<small>x64 · .exe / .msi</small>
      </a>
      <!-- 跳到同頁下方的「免費版與 Pro」購買區，不直接去銷售頁（Hevin 2026-10-05）：
           先讓人看到免費與 Pro 的差別和購買條款，再由那裡的按鈕去結帳。 -->
      <a class="btn buy" href="#tiers">
        購買 Pro 版<small>NT$3,000 · 一次買斷</small>
      </a>
      <a class="btn ghost" href="https://github.com/vulture-s/arkiv">
        看原始碼<small>GitHub</small>
      </a>
    </div>
    <p class="dl-note">
      <!-- 版號跑時向 GitHub 取。寫死過一次就過期一次（曾停在 v1.0.0 而實際已
           v1.1.1，同頁的定價表卻寫著「1.1.0（本版）」自相矛盾）。抓不到就整段
           不顯示 —— 沒有版號好過錯的版號。 -->
      安裝前請先看下方 <a href="#real">系統需求</a>　·　English:
      <a href="https://github.com/vulture-s/arkiv#readme">README</a><span id="relver" hidden>　·　最新版
      <span class="mono" id="relver-tag"></span></span>
    </p>
  </div>
</header>

<section class="shot-sec">
  <div class="wrap">
    <figure class="shot">
      <!-- 介面導覽短片：真實截圖逐區運鏡＋字卡（site/scripts/make-ui-tour.py 產生）。
           暫代版 —— 等乾淨示範庫的實機錄影出來再換（Hevin 2026-10-05）。
           poster 就是原截圖：影片載入前、或使用者關掉動態效果時，看到的是同一張真實畫面。 -->
      <video id="ui-tour" src="video/arkiv-ui-tour.mp4" poster="img/arkiv-ui.webp" width="1600" height="890"
             autoplay muted loop playsinline preload="metadata"
             aria-label="arkiv 操作介面導覽：口語搜尋、Smart Pool 與拍攝日、評等、場景時間軸、匯出"></video>
      <!-- 字卡放在頁面上而不是燒進影片：手機上影片只剩 350px 寬，燒進去的字會小到看不清。
           時間窗＝make-ui-tour.py 執行時印出的那五段（改了運鏡要一起改）。點一項跳到那一段。 -->
      <ol class="tour-steps">
        <li data-t0="3.2" data-t1="5.8"><button type="button"><span class="ts-n">01</span>口語搜尋：語意和條件寫在同一行</button></li>
        <li data-t0="7.0" data-t1="9.6"><button type="button"><span class="ts-n">02</span>Smart Pool 自動分池，拍攝日一路點到某一天</button></li>
        <li data-t0="10.8" data-t1="13.4"><button type="button"><span class="ts-n">03</span>GOOD／REV／N·G 直接標在素材上</button></li>
        <li data-t0="14.6" data-t1="17.2"><button type="button"><span class="ts-n">04</span>視覺模型逐場景寫描述，沒有對白也搜得到</button></li>
        <li data-t0="18.4" data-t1="21.0"><button type="button"><span class="ts-n">05</span>一鍵匯出 EDL、FCPXML、SRT</button></li>
      </ol>
    </figure>
  </div>
</section>

<Features />

