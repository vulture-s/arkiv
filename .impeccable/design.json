      "css": ":host{--ak-display:'Archivo Black','Inter',sans-serif;--ak-sans:'Inter','Noto Sans TC',system-ui,sans-serif;--ak-mono:'JetBrains Mono',ui-monospace,monospace;--bg:#0a0a0c;--surface:#111114;--surface-2:#17171a;--rule:#26262a;--rule-hi:#3a3a3f;--ink:#f3f2ee;--ink-2:#b6b5b0;--quiet:#6a6a6d;--invert:#f3f2ee;--invert-ink:#0a0a0c;--cyan:#18b6dc;--lg-dim:#8a8a8e} .ds-badge{font-family:var(--ak-mono);font-size:12px;color:var(--ink-2);border:1px solid var(--rule-hi);border-radius:999px;padding:5px 13px;background:var(--bg)}.ds-badge b{color:var(--cyan);font-weight:500}"
